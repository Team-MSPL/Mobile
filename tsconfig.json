{
	"extends": "@tsconfig/react-native/tsconfig.json",
	"compilerOptions": {
		"target": "es5",
		"module": "commonjs",
		"sourceMap": true,
		"outDir": "dist",
		"downlevelIteration": true,
		"strict": true,
		"noImplicitAny": false,
		"moduleResolution": "node",
		// "baseUrl": ".",
		"jsx": "react-native",

		// "paths": {
		// 	"*": ["node_modules/*"]
		// },

		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	}
}
